---
import '@fontsource/open-sans/latin-400.css';
import '@fontsource/open-sans/cyrillic-400.css';
import '@fontsource/open-sans/latin-400-italic.css';
import '@fontsource/open-sans/cyrillic-400-italic.css';
import '@fontsource/open-sans/latin-600.css';
import '@fontsource/open-sans/cyrillic-600.css';
import '@fontsource/open-sans/latin-700.css';
import '@fontsource/open-sans/cyrillic-700.css';
import '@fontsource/noto-serif/latin-400.css';
import '@fontsource/noto-serif/latin-400-italic.css';
import '../styles/global.css';

import SiteHeader from '../components/SiteHeader.astro';
import Sidebar from '../components/Sidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site, withBase, assetUrl } from '../config';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  bodyClass?: string;
}

const { title, description = site.description, type = 'website', published, modified, bodyClass } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={site.lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="max-image-preview:large" />
    <link rel="canonical" href={canonical} />

    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={`${site.title} | ${site.description}`} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>

  <body class={bodyClass}>
    <div id="page" class="hfeed site">
      <SiteHeader />

      <div id="main" class="site-main">
        <div class="header-image">
          <a href={withBase()} title={site.title} rel="home">
            <img
              src={assetUrl(site.headerImage.src)}
              width={site.headerImage.width}
              height={site.headerImage.height}
              alt=""
            />
          </a>
        </div>

        <div id="primary" class="content-area">
          <div id="content" class="site-content" role="main">
            <slot />
          </div>
        </div>

        <Sidebar />
      </div>

      <SiteFooter />
    </div>
  </body>
</html>
