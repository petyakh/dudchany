---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { excerptHtml } from '../lib/excerpt';

const PAGE_SIZE = 10;

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const posts = allPosts.slice(0, PAGE_SIZE);
const currentPage = 1;

const formatDate = (d: Date) =>
  d.toLocaleDateString('uk-UA', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout>
  {posts.map((post) => (
    <article class="post hentry">
      <header class="entry-header">
        <div class="entry-meta">
          <a href={`/${post.id}/`} rel="bookmark">
            <time class="entry-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          </a>
        </div>
        <h1 class="entry-title"><a href={`/${post.id}/`} rel="bookmark">{post.data.title}</a></h1>
      </header>
      <div class="entry-summary" set:html={excerptHtml(post.body ?? '')} />
      <p><a href={`/${post.id}/`}>Читати далі &rarr;</a></p>
    </article>
  ))}

  <nav class="pagination" aria-label="Навігація по сторінках">
    <span />
    <span class="pagination-current">Сторінка {currentPage} з {totalPages}</span>
    {totalPages > 1 && <a href="/page-2.html" rel="next">Старіші &rarr;</a>}
  </nav>
</BaseLayout>